## Opinionated matplotlib defaults for interactive & exploratory use.
## For publication figures, override per-project with PAPER_RC dicts
## (smaller fonts, usetex, etc.).

## -- Fonts ----------------------------------------------------------------
# 11pt is readable for Jupyter/interactive; publication scripts override to 8-9pt
font.size        : 11.0
font.family      : sans-serif

## -- Axes -----------------------------------------------------------------
# Remove top/right spines for a cleaner, Tufte-inspired look
axes.spines.top   : False
axes.spines.right : False
# Subtle grid helps read values off plots without dominating the figure
axes.grid         : True
axes.axisbelow    : True       # grid behind data elements, not on top

## -- Grid -----------------------------------------------------------------
grid.color     : #e0e0e0
grid.linewidth : 0.5

## -- Figure ---------------------------------------------------------------
# 150 dpi is noticeably crisper than default 100 in notebooks and on HiDPI screens
figure.dpi                      : 150
# constrained_layout is the modern replacement for tight_layout — avoids label clipping
figure.constrained_layout.use   : True

## -- Saving ---------------------------------------------------------------
# 300 dpi for saved files — good enough for print/publication without huge file sizes
savefig.dpi        : 300
savefig.bbox       : tight
savefig.pad_inches : 0.02

## -- PDF/PS font embedding ------------------------------------------------
# Type 42 (TrueType) instead of Type 3 — text stays editable in Illustrator/Inkscape
# and satisfies venue requirements (ICML, NeurIPS, etc.)
pdf.fonttype : 42
ps.fonttype  : 42
