[user]
	name = Jose Javier
	email = 26491792+josejg@users.noreply.github.com
	useConfigOnly = true
[core]
	editor = nvim
	excludesfile = ~/.gitignore_global
	pager = delta
[color]
	ui = auto
[init]
	defaultBranch = main

[push]
    autoSetupRemote = true
    followTags = true
[pull]
    rebase = false
[fetch]
    prune = true
    pruneTags = true
    all = true

[column]
    ui = auto
[branch]
    sort = -committerdate
[tag]
    sort = version:refname

[diff]
    tool = difftastic
    algorithm = histogram
    colorMoved = plain
    mnemonicPrefix = true
    renames = true
[difftool]
    prompt = false
[difftool "nvimdiff"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
[difftool "difftastic"]
    cmd = difft "$LOCAL" "$REMOTE"

[merge]
    tool = nvim
    conflictstyle = zdiff3
    prompt = false
[mergetool "nvim"]
    cmd = nvim -f -c \"Gdiffsplit!\" \"$MERGED\"

[log]
    date = iso
[help]
    autocorrect = prompt
[commit]
    verbose = true
[rerere]
    enabled = true
    autoupdate = true
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true

[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[alias]
    graph = log --all --graph --pretty=format:'%C(auto)%h%C(auto)%d %s %C(dim white)(%aN, %ar)'
    graph2 = log --graph --full-history --all --color --pretty=format:"%x1b[31m%h%x09%x1b[32m%d%x1b[0m%x20%s%x20%x1b[33m(%an)%x1b[0m"
    wip = for-each-ref --sort='authordate:iso8601' --format=' %(color:green)%(authordate:relative)%09%(color:white)%(refname:short)' refs/heads
    dlog = "-c diff.external=difft log -p --ext-diff"
    difft = "-c diff.external=difft diff"
    fpush = push --force-with-lease
    targz = "! targz() { git archive --format tar.gz --prefix=\"${PWD##*/}/\" HEAD -o ${1}; }; targz"
    zip = "! zip() { git archive --format zip --prefix=\"${PWD##*/}/\" HEAD -o ${1}; }; zip"

[url "git@github.com:"]
    insteadOf = "gh:"

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
